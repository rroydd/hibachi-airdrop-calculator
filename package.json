{
  "name": "airdrop-tools-service",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "portal",
    "hibachi",
    "nado"
  ],
  "scripts": {
    "dev:portal": "npm --workspace portal run dev",
    "dev:hibachi": "npm --workspace hibachi run dev",
    "dev:nado": "npm --workspace nado run dev",
    "build:portal": "npm --workspace portal run build",
    "build:hibachi": "npm --workspace hibachi run build",
    "build:nado": "npm --workspace nado run build",
    "lint:portal": "npm --workspace portal run lint",
    "lint:hibachi": "npm --workspace hibachi run lint",
    "lint:nado": "npm --workspace nado run lint"
  }
}
